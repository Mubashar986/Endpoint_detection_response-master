# ===========================================
# DOCKER IGNORE FILE
# ===========================================
# Files/folders to exclude from Docker image
# (reduces image size, speeds up builds)

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Docker
Dockerfile
docker-compose*.yml
.docker/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs
*.log
logs/

# Database
*.sqlite3
*.db

# Environment files (we use docker-compose env)
.env
.env.*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Documentation
docs/
*.md
!README.md

# Static files (collected in production)
staticfiles/
media/
